{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "adminplus:disguise_glow_squid",
      "materials": {
        "default": "glow_squid"
      },
      "textures": {
        "default": "textures/entity/glow_squid/glow_squid",
        "baby": "textures/entity/glow_squid/glow_squid_baby"
      },
      "geometry": {
        "default": "geometry.squid",
        "baby": "geometry.squid.baby"
      },
      "animations": {
        "move": "animation.squid.move",
        "squid_rotate": "animation.squid.rotate"
      },
      "render_controllers": [
        "controller.render.glow_squid.v2"
      ],
      "scripts": {
        "animate": [
          "move",
          "squid_rotate"
        ],
        "scale": "query.is_baby ? 2.0 : 1.0",
        "pre_animation": [
          "variable.glow_alpha = 0.0;",
          "variable.squid = 0.0;"
        ]
      }
    }
  }
}
